# Copy to .env.local (never commit real values; this site needs no secrets).
#
# SITE_URL is the public address of the deployed site, for example
#   https://your-name.pages.dev
#   https://your-github-username.github.io/portfolio
# When set, the build adds a canonical URL, og:url, an absolute og:image and
# JSON-LD "url". When empty, those tags are simply left out.
SITE_URL=

# Optional. Only needed if you deploy under a sub-path and want absolute asset
# URLs. The default "./" works on Cloudflare Pages, GitHub Pages and any
# static host without extra configuration.
# BASE_PATH=/
